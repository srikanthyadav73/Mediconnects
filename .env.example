# ==============================================================================
# CareBridge Environment Variables
# Copy this file to .env.local and populate with your project credentials.
# ==============================================================================

# Supabase (Auth, Postgres, Realtime & Storage)
# Obtain these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cron / Job Security
# Random 32+ character secret used to protect /api/jobs/* endpoints
CRON_SECRET=super-secret-random-token-here

# Meta WhatsApp Cloud API (Leave blank to enable automatic MOCK mode)
WHATSAPP_PHONE_NUMBER_ID=100609349512345
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=carebridge_meta_verify_token_secure
WHATSAPP_BUSINESS_ACCOUNT_ID=100508349512345

# Razorpay Payments Gateway (Leave blank to enable automatic MOCK mode)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

